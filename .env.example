# Feed Server API
VITE_FEED_BASE_URL=https://feed.feralfile.com

# When true/false, forces extension features (playlist extension + channels UI and JSON shape).
# When unset, the app uses GET /api/v1.extensionsEnabled from VITE_FEED_BASE_URL.
# VITE_DP1_EXTENSIONS_ENABLED=false

# WalletConnect Project ID (optional, get from https://cloud.walletconnect.com/)
VITE_WALLETCONNECT_PROJECT_ID=

# Dev server only: set to true to allow http:// and local/private playlist URLs when adding channels
VITE_DEBUG_MODE=

# "Load from series" (optional). Feral File API base: unset means the dev server goes
# through the Vite proxy at /ff-api (feralfile.com refuses the localhost origin) and
# production builds call https://feralfile.com/api directly. See DEVELOPMENT.md.
# VITE_FERALFILE_API_BASE_URL=https://feralfile.com/api

# "Load from series" (optional). IPFS gateway (…/ipfs) for objkt media; default below.
# VITE_IPFS_GATEWAY_BASE_URL=https://ipfs.feralfile.com/ipfs
