# Feed Server API
VITE_FEED_BASE_URL=https://feed.feralfile.com

# Indexer API (ff-indexer-v2). GraphQL endpoint is <base>/graphql.
# Requires ff-indexer-v2 with the series-expand API (releases query + tokens release_id
# + TokenSortBy.mint_number). See DEVELOPMENT.md for version requirements.
VITE_INDEXER_BASE_URL=https://indexer.feralfile.com

# When true/false, forces extension features (playlist extension + channels UI and JSON shape).
# When unset, the app uses GET /api/v1.extensionsEnabled from VITE_FEED_BASE_URL.
# VITE_DP1_EXTENSIONS_ENABLED=false

# WalletConnect Project ID (optional, get from https://cloud.walletconnect.com/)
VITE_WALLETCONNECT_PROJECT_ID=

# Dev server only: set to true to allow http:// and local/private playlist URLs when adding channels
VITE_DEBUG_MODE=
